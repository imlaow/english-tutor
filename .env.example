# GEMINI_API_KEY: Required for Gemini AI API calls (conversation, onboarding, topic generation).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# AZURE_SPEECH_KEY / AZURE_SPEECH_REGION: Required for Azure Cognitive Services Speech (TTS, en-US-JennyNeural).
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=YOUR_AZURE_SPEECH_REGION
