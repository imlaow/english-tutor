<!-- Lucide `x`, drawn to the handoff's icon spec (viewBox 24, stroke-width 2.75,
     round caps/joins, no fill) rather than traced from a screen: it marks a failed
     connection probe, which the four designed screens never show.
     Stroke color is a placeholder: every use site tints it via Icon(tint = ...). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M18 6 6 18"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="m6 6 12 12"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
