<!-- Lucide `check`, drawn to the handoff's icon spec (viewBox 24, stroke-width 2.75,
     round caps/joins, no fill) rather than traced from a screen: the connection-test
     result rows on the edit form have no counterpart in the four designed screens.
     Stroke color is a placeholder: every use site tints it via Icon(tint = ...). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M20 6 9 17l-5-5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
